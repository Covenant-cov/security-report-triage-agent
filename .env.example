# Copy to .env (never commit .env) or set these in your shell.

# Required for real triage. Without it the app runs in mock mode.
ANTHROPIC_API_KEY=

# auto (default) | claude | mock
TRIAGE_MODE=auto
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=medium

# Optional: Slack incoming webhook for notifications
SLACK_WEBHOOK_URL=

# Optional: shared secret callers must send in the X-Webhook-Secret header
WEBHOOK_SECRET=

TRIAGE_DB=triage.db
